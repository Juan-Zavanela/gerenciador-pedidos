<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List" %>
<%@ page import="model.Produto" %>
<%@ page import="model.DecoratorAdicional" %>
<%
    List<Produto> produtos = (List<Produto>) request.getAttribute("produtos");
    List<DecoratorAdicional> garantias = (List<DecoratorAdicional>) request.getAttribute("garantias");
    List<DecoratorAdicional> fretes = (List<DecoratorAdicional>) request.getAttribute("fretes");
    List<DecoratorAdicional> brindes = (List<DecoratorAdicional>) request.getAttribute("brindes");
    List<DecoratorAdicional> personalizacoes = (List<DecoratorAdicional>) request.getAttribute("personalizacoes");
    String erro = (String) request.getAttribute("erro");
%>
<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Novo Pedido</title>
<style>
*{box-sizing:border-box}body{margin:0;font-family:Arial;background:#f4f6f8;color:#1f2937}.container{max-width:1100px;margin:35px auto;padding:0 20px}.card{background:#fff;border-radius:14px;padding:28px;box-shadow:0 8px 24px rgba(0,0,0,.08)}.topo{display:flex;justify-content:space-between;align-items:center;margin-bottom:22px}h1,h3{margin:0}h3{margin-top:25px;margin-bottom:12px}label{font-weight:bold}input,select{width:100%;padding:10px;border:1px solid #d1d5db;border-radius:8px}.cliente-input{max-width:460px}.linha-item{display:grid;grid-template-columns:1fr 95px 240px 95px;gap:10px;align-items:center;margin-bottom:10px}.grid-adicionais{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.ajuda{color:#6b7280;font-size:13px;margin-top:6px}.resumo{margin-top:24px;border-radius:12px;padding:18px;background:#111827;color:#fff;display:grid;grid-template-columns:repeat(5,1fr);gap:15px}.resumo span{display:block;margin-top:5px;font-size:20px;font-weight:bold}.acoes{display:flex;gap:10px;margin-top:24px;flex-wrap:wrap}button,.btn{border:none;border-radius:8px;padding:10px 14px;cursor:pointer;text-decoration:none;font-size:14px}.btn-primary{background:#2563eb;color:white}.btn-secondary{background:#e5e7eb;color:#111827}.btn-danger{background:#fee2e2;color:#991b1b}.erro{padding:12px;background:#fee2e2;color:#991b1b;border-radius:8px;margin-bottom:16px}.vazio{padding:18px;border-radius:10px;background:#fff7ed}@media(max-width:850px){.grid-adicionais,.resumo{grid-template-columns:1fr}.linha-item{grid-template-columns:1fr}}
</style></head><body><div class="container"><div class="card"><div class="topo"><h1>Novo Pedido</h1><a class="btn btn-secondary" href="pedidos?action=listar">← Voltar</a></div>
<% if (erro != null && !erro.isEmpty()) { %><div class="erro"><%= erro %></div><% } %>
<% if (produtos == null || produtos.isEmpty()) { %><div class="vazio"><p>Cadastre pelo menos um produto antes de criar pedidos.</p><a class="btn btn-primary" href="produtos?action=novo">Cadastrar produto</a></div><% } else { %>
<form action="pedidos" method="post">
<label>Cliente</label><br><input class="cliente-input" type="text" name="cliente" placeholder="Nome do cliente" required>
<h3>Itens do pedido</h3><div class="ajuda">A garantia é um Decorator cadastrado no banco e aplicada individualmente em cada produto.</div><br><div id="itensContainer"></div><button class="btn-secondary" type="button" onclick="adicionarLinhaItem()">+ Adicionar produto</button>
<h3>Decorators do pedido</h3><div class="ajuda">Frete, brinde premium e personalização são adicionais gerenciados pelo banco e aplicados no total final.</div><br>
<div class="grid-adicionais">
<div><label>Frete</label><select name="decoratorFreteId" id="decoratorFreteId" onchange="calcularPreview()"><option value="0" data-valor="0" data-percentual="false">Sem frete</option><% if (fretes != null) { for (DecoratorAdicional f : fretes) { %><option value="<%= f.getId() %>" data-valor="<%= f.getValor() %>" data-percentual="<%= f.isPercentual() %>"><%= f.getDescricao() %></option><% }} %></select></div>
<div><label>Brinde Premium</label><select name="decoratorBrindeId" id="decoratorBrindeId" onchange="calcularPreview()"><option value="0" data-valor="0" data-percentual="false">Sem brinde</option><% if (brindes != null) { for (DecoratorAdicional b : brindes) { %><option value="<%= b.getId() %>" data-valor="<%= b.getValor() %>" data-percentual="<%= b.isPercentual() %>"><%= b.getDescricao() %></option><% }} %></select></div>
<div><label>Personalização</label><select name="decoratorPersonalizacaoId" id="decoratorPersonalizacaoId" onchange="calcularPreview()"><option value="0" data-valor="0" data-percentual="false">Sem personalização</option><% if (personalizacoes != null) { for (DecoratorAdicional pe : personalizacoes) { %><option value="<%= pe.getId() %>" data-valor="<%= pe.getValor() %>" data-percentual="<%= pe.isPercentual() %>"><%= pe.getDescricao() %></option><% }} %></select></div>
</div>
<div class="resumo"><div>Produtos <span>R$ <span id="totalBase">0.00</span></span></div><div>Garantias <span>R$ <span id="totalGarantias">0.00</span></span></div><div>Frete <span>R$ <span id="totalFrete">0.00</span></span></div><div>Outros <span>R$ <span id="totalOutros">0.00</span></span></div><div>Total final <span>R$ <span id="totalFinal">0.00</span></span></div></div>
<div class="acoes"><button class="btn-primary" type="submit">Salvar pedido</button><a class="btn btn-secondary" href="pedidos?action=listar">Cancelar</a><a class="btn btn-secondary" href="decorators?action=listar">Gerenciar Decorators</a></div></form><% } %></div></div>
<script>
function adicionarLinhaItem(){var container=document.getElementById("itensContainer");var div=document.createElement("div");div.className="linha-item";div.innerHTML=`<select name="produtoId" onchange="calcularPreview()"><% for (Produto p : produtos) { %><option value="<%= p.getId() %>" data-preco="<%= p.getPreco() %>"><%= p.getDescricaoCurta() %> - R$ <%= String.format("%.2f", p.getPreco()) %></option><% } %></select><input type="number" name="quantidade" value="1" min="1" oninput="calcularPreview()"><select name="decoratorGarantiaId" onchange="calcularPreview()"><option value="0" data-valor="0" data-percentual="true">Sem garantia</option><% if (garantias != null) { for (DecoratorAdicional g : garantias) { %><option value="<%= g.getId() %>" data-valor="<%= g.getValor() %>" data-percentual="<%= g.isPercentual() %>"><%= g.getDescricao() %></option><% }} %></select><button class="btn-danger" type="button" onclick="this.parentElement.remove();calcularPreview();">Remover</button>`;container.appendChild(div);calcularPreview();}
function valorDecorator(selectId, base){var s=document.getElementById(selectId);var opt=s.options[s.selectedIndex];var valor=parseFloat(opt.getAttribute("data-valor")||"0");var percentual=(opt.getAttribute("data-percentual")||"false")==="true";return percentual ? base*valor/100 : valor;}
function calcularPreview(){var totalBase=0,totalGarantias=0;document.querySelectorAll(".linha-item").forEach(function(linha){var ps=linha.querySelector("select[name='produtoId']"),q=linha.querySelector("input[name='quantidade']"),gs=linha.querySelector("select[name='decoratorGarantiaId']");var preco=parseFloat(ps.options[ps.selectedIndex].getAttribute("data-preco"));var qtd=parseInt(q.value||"0");var valor=parseFloat(gs.options[gs.selectedIndex].getAttribute("data-valor")||"0");var percentual=(gs.options[gs.selectedIndex].getAttribute("data-percentual")||"true")==="true";if(!isNaN(preco)&&!isNaN(qtd)){var subtotal=preco*qtd;totalBase+=subtotal;totalGarantias+=percentual ? subtotal*valor/100 : valor*qtd;}});var baseComGarantias=totalBase+totalGarantias;var frete=valorDecorator("decoratorFreteId",baseComGarantias);var brinde=valorDecorator("decoratorBrindeId",baseComGarantias);var personalizacao=valorDecorator("decoratorPersonalizacaoId",baseComGarantias);var outros=brinde+personalizacao;var totalFinal=baseComGarantias+frete+outros;document.getElementById("totalBase").innerText=totalBase.toFixed(2);document.getElementById("totalGarantias").innerText=totalGarantias.toFixed(2);document.getElementById("totalFrete").innerText=frete.toFixed(2);document.getElementById("totalOutros").innerText=outros.toFixed(2);document.getElementById("totalFinal").innerText=totalFinal.toFixed(2);}
<% if (produtos != null && !produtos.isEmpty()) { %>window.onload=function(){adicionarLinhaItem();};<% } %>
</script></body></html>
